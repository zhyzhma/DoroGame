<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="001-create-doro-games-table" author="kirillvodu">
        <sqlFile path="changes/001-create-doro-games-table.sql" relativeToChangelogFile="true" splitStatements="true"/>
    </changeSet>

    <changeSet id="002-create-chip-entity-table" author="kirillvodu">
        <sqlFile path="changes/002-create-chip-entity-table.sql" relativeToChangelogFile="true" splitStatements="true"/>
    </changeSet>

    <changeSet id="003-create-invitations-table" author="kirillvodu">
        <sqlFile path="changes/003-create-invitations-table.sql" relativeToChangelogFile="true" splitStatements="true"/>
    </changeSet>

    <changeSet id="004-create-outbox-events-table" author="kirillvodu">
        <sqlFile path="changes/004-create-outbox-events-table.sql" relativeToChangelogFile="true" splitStatements="true"/>
    </changeSet>

    <changeSet id="005-setup-debezium-replication-group" author="kirillvodu">
        <sqlFile path="changes/005-setup-debezium-replication-group.sql" relativeToChangelogFile="true" splitStatements="false"/>
        <rollback>
            <sql>ALTER TABLE outbox_events OWNER TO CURRENT_USER;</sql>
            <sql>DROP ROLE replication_group;</sql>
        </rollback>
    </changeSet>

    <changeSet id="006-rename-chip-entity-to-start-positions" author="kirillvodu">
        <sqlFile path="changes/006-rename-chip-entity-to-start-positions.sql" relativeToChangelogFile="true" splitStatements="true"/>
        <rollback>
            <sql>DROP INDEX IF EXISTS idx_start_positions_game_id;</sql>
            <sql>ALTER TABLE start_positions RENAME CONSTRAINT fk_start_positions_game_id TO fk_chip_entity_game_id;</sql>
            <sql>ALTER TABLE start_positions RENAME TO chip_entity;</sql>
        </rollback>
    </changeSet>

    <changeSet id="007-add-move-counter-to-doro-games" author="kirillvodu">
        <sqlFile path="changes/007-add-move-counter-to-doro-games.sql" relativeToChangelogFile="true" splitStatements="true"/>
        <rollback>
            <sql>ALTER TABLE doro_games DROP COLUMN IF EXISTS move_counter;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-create-chip-move-entity-table" author="kirillvodu">
        <sqlFile path="changes/008-create-chip-move-entity-table.sql" relativeToChangelogFile="true" splitStatements="true"/>
        <rollback>
            <sql>DROP TABLE IF EXISTS chip_move_entity;</sql>
        </rollback>
    </changeSet>

    <changeSet id="009-drop-sent-from-outbox-events" author="kirillvodu">
        <sqlFile path="changes/009-drop-sent-from-outbox-events.sql" relativeToChangelogFile="true" splitStatements="true"/>
        <rollback>
            <sql>ALTER TABLE outbox_events ADD COLUMN sent BOOLEAN NOT NULL DEFAULT FALSE;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
